NEXT_PUBLIC_BASE_URL=https://www.automated-sales.com
NEXT_PUBLIC_SITE_NAME="Automated Sales"

# --- Contact form (Resend) ---
# Get an API key at https://resend.com/api-keys (free tier: 100 emails/day).
# Put real values in .env.local (gitignored), NOT in this file.
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Where contact form enquiries are delivered
CONTACT_TO=hello@automated-sales.com

# Sender. Default uses Resend's verified domain — no domain setup needed.
# Once you verify automated-sales.com in Resend, change to:
#   CONTACT_FROM="Automated Sales <hello@automated-sales.com>"
CONTACT_FROM="Automated Sales <onboarding@resend.dev>"

# Optional: Google Search Console verification
GOOGLE_VERIFICATION_CODE=

# --- AI chat support agent ---
# Get an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
# Stored Prompt id from the OpenAI dashboard. The prompt carries its own model
# and system instructions, so OPENAI_MODEL is no longer used.
OPENAI_PROMPT_ID=pmpt_xxxxxxxxxxxxxxxxxxxx

# --- Pipedrive CRM sync ---
# Personal API token — Pipedrive → Settings → Personal preferences → API
PIPEDRIVE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Pipedrive company subdomain, i.e. <DOMAIN>.pipedrive.com
PIPEDRIVE_DOMAIN=automatedsales

# Where new-chat-enquiry notification emails go (sent via Resend).
# Defaults to dan@automated-sales.com if unset.
CHAT_NOTIFY_TO=dan@automated-sales.com

# --- Blog publish API (POST /api/blog) ---
# Shared secret. Callers must send it as the x-blog-api-key request header.
BLOG_API_KEY=

# Fine-grained GitHub PAT scoped to this repo only, with "Contents: read and
# write" permission. Generate at https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
# owner/repo that the site's Vercel project deploys from.
GITHUB_REPO=nehalazhar2/automated-sales
# Branch to commit new posts to. Must be the branch Vercel auto-deploys.
GITHUB_BRANCH=main

# --- Pipedrive QuickStart (qualification -> approval -> onboarding) ---
# See docs/quickstart.md. All optional locally; the feature runs in test mode
# (no Pipedrive writes, no emails) unless VERCEL_ENV=production.

# Staff admin password for /pipedrive-quickstart/admin/ (>= 16 characters).
# The admin page is disabled while this is unset or shorter.
QUICKSTART_ADMIN_KEY=

# Where staff notification emails go (falls back to CONTACT_TO).
QUICKSTART_NOTIFY_TO=

# Set to 1 to force test mode even in production (smoke tests): no Pipedrive
# writes and no emails; projects are flagged test_mode.
QUICKSTART_TEST_MODE=

# Local-dev data directory for the file store (default: .data/quickstart).
# Ignored when BLOB_READ_WRITE_TOKEN is set. On Vercel the file store is NOT used.
QUICKSTART_DATA_DIR=

# Vercel Blob read/write token. Create a PRIVATE Blob store and connect it to BOTH the
# Production and Preview environments. Required on Vercel: without it leads cannot be saved.
# Data is isolated per environment by the VERCEL_ENV path prefix (production/, preview/),
# so Preview deployments never read or write production records.
BLOB_READ_WRITE_TOKEN=

# NOTE: NEXT_PUBLIC_BASE_URL (above) builds the onboarding links staff send out.
# It must be set on staging/preview to that environment's URL, otherwise links
# point at the production site.

# Pipedrive deals for approved QuickStart customers (all optional positive integers; ignored if invalid).
# Unset = Pipedrive's default pipeline and no stage moves.
QUICKSTART_PIPEDRIVE_PIPELINE_ID=
# Stage given to the deal when staff approve ("Onboarding sent").
QUICKSTART_PIPEDRIVE_STAGE_SENT_ID=
# Stage the deal moves to when the customer submits onboarding ("Onboarding received").
QUICKSTART_PIPEDRIVE_STAGE_RECEIVED_ID=
