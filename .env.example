NEXT_PUBLIC_BASE_URL=https://www.automated-sales.com
NEXT_PUBLIC_SITE_NAME="Automated Sales"

# --- Contact form (Resend) ---
# Get an API key at https://resend.com/api-keys (free tier: 100 emails/day).
# Put real values in .env.local (gitignored), NOT in this file.
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Where contact form enquiries are delivered
CONTACT_TO=hello@automated-sales.com

# Sender. Default uses Resend's verified domain — no domain setup needed.
# Once you verify automated-sales.com in Resend, change to:
#   CONTACT_FROM="Automated Sales <hello@automated-sales.com>"
CONTACT_FROM="Automated Sales <onboarding@resend.dev>"

# Optional: Google Search Console verification
GOOGLE_VERIFICATION_CODE=

# --- AI chat support agent ---
# Get an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
# Stored Prompt id from the OpenAI dashboard. The prompt carries its own model
# and system instructions, so OPENAI_MODEL is no longer used.
OPENAI_PROMPT_ID=pmpt_xxxxxxxxxxxxxxxxxxxx

# --- Pipedrive CRM sync ---
# Personal API token — Pipedrive → Settings → Personal preferences → API
PIPEDRIVE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Pipedrive company subdomain, i.e. <DOMAIN>.pipedrive.com
PIPEDRIVE_DOMAIN=automatedsales
